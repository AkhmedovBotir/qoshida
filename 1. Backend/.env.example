APP_ENV=development
APP_NAME=qoshida-backend
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=qoshida
DB_SSLMODE=require
DB_MAX_CONNS=20
DB_MIN_CONNS=2

JWT_SECRET=replace-with-long-random-secret-min-32-chars
JWT_ISSUER=qoshida
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

CORS_ORIGINS=http://localhost:3010,http://localhost:3011
REQUEST_TIMEOUT=15s
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_RPM=120
AUTH_RATE_LIMIT_RPM=10
COOKIE_SECURE=true

ADMIN_FIRST_NAME=General
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=+998901234567
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SENDER=4546
ESKIZ_TIMEOUT=15s
