{
  "name": "qoshida-sotuvchi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "build": "vite build",
    "build:web": "vite build",
    "build:capacitor": "vite build --mode capacitor",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "mobile:sync": "npm run build:capacitor && cap sync",
    "mobile:android": "npm run build:capacitor && cap sync && cap open android",
    "mobile:ios": "npm run build:capacitor && cap sync && cap open ios",
    "cap:icons": "npx @capacitor/assets generate --assetPath assets --android --ios --iconBackgroundColor \"#15803D\" --splashBackgroundColor \"#15803D\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "lucide-react-native": "^1.45.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "twrnc": "^4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "tar": "^7.5.7",
    "uuid": "^13.0.0",
    "glob": "^13.0.0"
  }
}
